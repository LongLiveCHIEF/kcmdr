{
	"name": "ratos-cli",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"build": "tsx ./build.ts",
		"cli": "cd ../configurator && node ../cli/dist/ratos.mjs",
		"lint": "eslint --ext .ts,.tsx src",
		"lint:fix": "eslint --ext .ts,.tsx src --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:dev": "vitest dev",
		"test:ci": "vitest run --reporter=verbose --reporter=junit"
	},
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@schema-hub/zod-error-formatter": "^0.0.8",
		"@trpc/client": "10.45.1",
		"commander": "^11.1.0",
		"ink": "^5.0.0",
		"ink-progress-bar": "^3.0.0",
		"ink-spinner": "^5.0.0",
		"ink-table": "^3.1.0",
		"luxon": "^3.4.4",
		"object-hash": "^3.0.0",
		"pino": "^8.17.2",
		"pino-pretty": "^10.3.1",
		"progress-stream": "^2.0.0",
		"react": "18.2.0",
		"read-package-up": "^11.0.0",
		"zod": "^3.22.4",
		"zx": "^8.1.4"
	},
	"devDependencies": {
		"@limegrass/eslint-plugin-import-alias": "^1.3.0",
		"@types/luxon": "^3.4.2",
		"@types/node": "18.19.4",
		"@types/object-hash": "^3.0.6",
		"@types/progress-stream": "^2.0.5",
		"@types/react": "18.2.21",
		"@typescript-eslint/eslint-plugin": "^7.0.2",
		"@typescript-eslint/parser": "^6.19.0",
		"@vitest/coverage-v8": "^1.1.1",
		"dotenv": "^16.3.1",
		"esbuild": "^0.20.0",
		"esbuild-plugin-pino": "^2.2.0",
		"eslint": "^8.56.0",
		"eslint-config-next": "13.5.6",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-unused-imports": "^3.0.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.2.4",
		"tsx": "^4.7.0",
		"typescript": "5.5.2",
		"vitest": "^1.6.0"
	},
	"nx": {
		"implicitDependencies": [
			"ratos-configurator"
		],
		"targets": {
			"build": {
				"dependsOn": [],
				"outputs": [
					"{projectRoot}/dist"
				]
			},
			"test": {
				"dependsOn": []
			},
			"test:ci": {
				"dependsOn": []
			}
		}
	}
}
