[Unit]
Description=RatOS Configurator service
Requires=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=__RATOS_USERNAME__
SupplementaryGroups=ratos-configurator
RemainAfterExit=yes
WorkingDirectory=__APP_DIR__
# Release installs: finish installing a release Moonraker just extracted (pnpm install, links,
# system files), then run the RatOS configuration update once the server answers.
# Both run as root ("+"); a failed pre-start ("-") is retried on the next start. No-op in source checkouts.
ExecStartPre=-+__APP_DIR__/src/scripts/release-update.sh pre-start
ExecStart=pnpm start
ExecStartPost=+__APP_DIR__/src/scripts/release-update.sh post-start
# Installing a release's dependencies on a Pi can take a few minutes.
TimeoutStartSec=900
Restart=always
RestartSec=10
StandardOutput=append:/var/log/ratos-configurator.log
StandardError=append:/var/log/ratos-configurator.log