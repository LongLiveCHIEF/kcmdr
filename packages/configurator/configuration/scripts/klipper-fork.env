# RatOS's Kalico-based Klipper fork, which carries the features RatOS depends on.
# Read by klipper-fork-migration.sh and by the RatOS image build (modules/generic/50-kalico),
# so printers are installed and migrated to the same fork. The commit is pinned in
# ../moonraker.conf ([update_manager klipper] pinned_commit).
# TESTING: this points at the test fork on LongLiveCHIEF's GitHub account. Before release,
# switch it to https://github.com/Rat-OS/kalico.git and the branch to ratos/v2.1.x.
RATOS_FORK_URL="https://github.com/LongLiveCHIEF/kalico.git"
# Printers check it out as a local branch of the same name.
RATOS_FORK_BRANCH="add-ratos-dependent-features"
