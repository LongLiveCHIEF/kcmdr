#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

# Kalico is installed where Klipper would be (~/klipper, ~/klippy-env, klipper.service), so
# Moonraker, the RatOS configuration and the configurator find it in the usual places.
SRC_DIR="/home/${BASE_USER}/klipper"
ENV_DIR="/home/${BASE_USER}/klippy-env"

# RatOS's Kalico fork, at the commit the RatOS configurator expects. The fork URL/branch and the
# pinned commit are read from the configurator release built from the same commit as this image
# (the build workflow puts it in /files/ratos), so Moonraker's update manager and the configurator's
# Klipper fork migration agree with what is installed.
CONFIGURATOR_RELEASE="/files/ratos/ratos-configurator.tar.gz"

release_file() {
    tar -xzOf "${CONFIGURATOR_RELEASE}" "./packages/configurator/$1"
}

# Defines RATOS_FORK_URL and RATOS_FORK_BRANCH
# shellcheck source=/dev/null
source <(release_file configuration/scripts/klipper-fork.env)
PINNED_COMMIT=$(release_file configuration/moonraker.conf | awk '
    /^\[update_manager klipper\]/ { in_section = 1; next }
    /^\[/ { in_section = 0 }
    in_section && /^pinned_commit:/ { print $2; exit }
')

if [ -z "${RATOS_FORK_URL:-}" ] || [ -z "${RATOS_FORK_BRANCH:-}" ] || [ -z "${PINNED_COMMIT}" ]; then
    echo "Could not read the Kalico fork, branch or pinned commit from ${CONFIGURATOR_RELEASE}" >&2
    exit 1
fi
echo "Installing Kalico from ${RATOS_FORK_URL} (${RATOS_FORK_BRANCH} at ${PINNED_COMMIT})"

DEPS=(git \
      # Packages for python cffi
      virtualenv python3-dev libffi-dev build-essential \
      # kconfig requirements
      libncurses-dev pkg-config \
      # hub-ctrl
      libusb-dev libusb-1.0-0-dev \
      # AVR chip installation and building
      avrdude gcc-avr binutils-avr avr-libc \
      # ARM chip installation and building
      stm32flash dfu-util libnewlib-arm-none-eabi \
      gcc-arm-none-eabi binutils-arm-none-eabi libusb-1.0-0 \
      # Input shaper dependencies
      python3-numpy python3-matplotlib libopenblas-dev \
      )

# libatlas-base-dev was merged into libopenblas-dev in Trixie and is no longer available
if [ "$(is_in_apt libatlas-base-dev)" -eq 1 ]; then
  DEPS+=(libatlas-base-dev)
fi

########################################
# Install Dependencies                 #
########################################

echo "Installing Dependencies"
apt-get install --yes "${DEPS[@]}"

########################################
# Add user to groups                   #
########################################

## Make sure user pi has access to serial ports
usermod -a -G "tty,dialout" "${BASE_USER}"

########################################
# Switch into home dir                 #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1

########################################
# Clone repository                     #
########################################

echo "Cloning repo ..."
sudo -u "${BASE_USER}" git clone --branch "${RATOS_FORK_BRANCH}" "${RATOS_FORK_URL}" klipper
# The configurator's migration treats this branch at the pinned commit as already migrated.
sudo -u "${BASE_USER}" git -C klipper checkout -B "${RATOS_FORK_BRANCH}" "${PINNED_COMMIT}"

########################################
# Create printer_data directories      #
########################################

create_user_directories

########################################
# Create Virtualenv and install        #
# dependencies                         #
########################################

echo "Creating Virtualenv (klippy-env) ..."
sudo -u "${BASE_USER}" virtualenv -p python3 "${ENV_DIR}"
echo "Installing Python Dependencies ..."
# Kalico's requirements pin NumPy for each Python version (including Trixie's 3.13), so no
# separate NumPy install is needed.
sudo -u "${BASE_USER}" "${ENV_DIR}"/bin/pip install -r "${SRC_DIR}"/scripts/klippy-requirements.txt

########################################
# Return to saved directory            #
########################################

popd &> /dev/null || exit 1

########################################
# Copy and enable service              #
########################################

echo "Copy Service and enable it"
cp /files/klipper.service /etc/systemd/system/klipper.service
cp /files/klipper.env /home/"${BASE_USER}"/printer_data/systemd/klipper.env
chown -R "${BASE_USER}":"${BASE_USER}" /home/"${BASE_USER}"/printer_data/systemd/klipper.env
systemctl_if_exists enable klipper.service
